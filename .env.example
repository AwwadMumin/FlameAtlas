MONGODB_URI=mongodb://mongo:27017/?directConnection=true
MONGODB_DB=ignis_mu
CORS_ORIGINS=*
MOCK=0
EMBED_MODEL=all-MiniLM-L6-v2
# Optional. Without a key the app is fully functional (template summaries).
ANTHROPIC_API_KEY=
# Or a free Gemini key (aistudio.google.com/apikey). With both set, Anthropic is used unless LLM_PROVIDER=gemini.
GEMINI_API_KEY=
# LLM_PROVIDER=auto   # auto | anthropic | gemini
# GEMINI_MODEL=gemini-2.5-flash
# LLM_MODEL=claude-opus-5-5
MONGO_PORT=27018
